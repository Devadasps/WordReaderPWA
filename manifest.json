{
  "name": "DocTools Suite",
  "short_name": "DocTools",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#1e1e1e",
  "background_color": "#121212",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "/index.html",
      "accept": {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [".docx"]
      }
    },
    {
      "action": "/pdfviewer.html",
      "accept": {
        "application/pdf": [".pdf"]
      }
    }
  ]
}